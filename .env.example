# Backend application settings
COMPOSE_PROJECT_NAME=connect-web

# Local development ports (bound to localhost only).
FRONTEND_PORT=5173
BACKEND_PORT=8000

# PostgreSQL credentials. Change the example password for your local environment.
POSTGRES_DB=connect_web
POSTGRES_USER=connect_web
POSTGRES_PASSWORD=change-me

# Backend application settings.
APP_NAME=Connect Web API
APP_ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Generate a private random value for JWT_SECRET_KEY (for example: openssl rand -hex 32).
JWT_SECRET_KEY=replace-with-a-random-secret-before-use
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Leave empty to use the Vite /api proxy, or set a backend origin such as
# http://localhost:8000 when the browser should call FastAPI directly.
VITE_API_BASE_URL=
